OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.teamrouter.com/v1
OPENAI_MODEL=gpt-6-luna

# Amap remote MCP. Keep real credentials only in local .env or deployment secrets.
AMAP_MCP_URL=https://mcp.amap.com/mcp
AMAP_MCP_KEY=
MCP_BEARER_TOKEN=

# Keep sample data by default. Set to dianping only after browser-harness is ready.
RESTAURANT_PROVIDER=dianping
BROWSER_HARNESS_EXECUTABLE=browser-harness
AGENT_SESSION_DB_PATH=:memory:
AGENT_WORKFLOW_TIMEOUT_SECONDS=60
AGENT_MAX_WORKFLOW_STEPS=12

# Feishu bot adapter. Keep credentials only in local .env or deployment secrets.
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_API_BASE_URL=https://open.feishu.cn/open-apis
